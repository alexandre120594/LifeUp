datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String?
  goals                 Goal[]
  financialCategories   FinancialCategory[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]
  financialCommitments  FinancialCommitment[]
  financialImports      FinancialImport[]
  savingsGoals          SavingsGoal[]
  savingsContributions  SavingsContribution[]
  pomodoroSessions      PomodoroSession[]
  inboxItems            InboxItem[]
  notes                 Note[]
  lifeHabits            LifeHabit[]
  notifications         Notification[]
  studySubjects         StudySubject[]
  studyTopics           StudyTopic[]
  studyReviews          StudyReview[]
  studySessions         StudySession[]
  createdAt             DateTime               @default(now())
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum GoalArea {
  BODY
  MIND
  HOME
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  area        GoalArea   @default(MIND)
  status      GoalStatus @default(ACTIVE)
  progress    Int        @default(0)
  targetDate  DateTime?
  color       String?
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, area])
  @@index([userId, targetDate])
}

model LifeHabit {
  id         String    @id @default(cuid())
  title      String
  kind       String // good or bad
  color      String?
  notes      String?
  targetDays Int       @default(30)
  reward     String?
  checkins   String[]  @default([])
  badEvents  String[]  @default([])
  lastBadAt  DateTime?
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, kind])
  @@index([userId, updatedAt])
}

model StudySubject {
  id                    String            @id @default(cuid())
  name                  String
  color                 String?
  plannedMinutesPerWeek Int               @default(60)
  notes                 String?
  isActive              Boolean           @default(true)
  userId                Int
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessions              StudySession[]
  pomodoroSessions      PomodoroSession[]
  topics                StudyTopic[]
  reviews               StudyReview[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([userId, name])
}

model StudyTopic {
  id               String            @id @default(cuid())
  name             String
  isActive         Boolean           @default(true)
  subjectId        String
  subject          StudySubject      @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId           Int
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessions         StudySession[]
  reviews          StudyReview[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pomodoroSessions PomodoroSession[]

  @@unique([subjectId, name])
  @@index([userId, isActive])
}

model StudySession {
  id               String       @id @default(cuid())
  startedAt        DateTime
  endedAt          DateTime
  durationMinutes  Int
  notes            String?
  totalQuestions   Int?
  correctQuestions Int?
  subjectId        String
  subject          StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId           Int
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  topicId          String?
  topic            StudyTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId, startedAt])
  @@index([userId, subjectId])
  @@index([userId, topicId])
}

model InboxItem {
  id        String   @id @default(cuid())
  title     String
  content   String?
  type      String   @default("idea")
  status    String   @default("unprocessed")
  noteId    String?
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id         String      @id @default(cuid())
  title      String
  content    String
  category   String?
  inboxItems InboxItem[]
  userId     Int
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model PomodoroSession {
  id              String        @id @default(cuid())
  title           String?
  durationMinutes Int
  focusType       String        @default("study") // study focus sessions
  startedAt       DateTime
  endedAt         DateTime
  notes           String?
  subjectId       String?
  subject         StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  studyTopic      StudyTopic?   @relation(fields: [studyTopicId], references: [id])
  studyTopicId    String?

  @@index([userId, endedAt])
  @@index([userId, subjectId])
}

model StudyReview {
  id             String       @id @default(cuid())
  prompt         String
  answer         String?
  notes          String?
  dueAt          DateTime
  status         String       @default("pending")
  lastReviewedAt DateTime?
  subjectId      String
  subject        StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  topicId        String?
  topic          StudyTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, status, dueAt])
  @@index([userId, subjectId])
}

model FinancialCategory {
  id           String                 @id @default(cuid())
  name         String
  type         String // income or expense
  color        String?
  icon         String?
  isDefault    Boolean                @default(false)
  userId       Int
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions FinancialTransaction[]
  commitments  FinancialCommitment[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, name, type])
}

model FinancialAccount {
  id             String                 @id @default(cuid())
  name           String
  openingBalance Decimal                @default(0) @db.Decimal(12, 2)
  isActive       Boolean                @default(true)
  userId         Int
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions   FinancialTransaction[]
  commitments    FinancialCommitment[]
  imports        FinancialImport[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, name])
  @@index([userId, isActive])
}

model FinancialTransaction {
  id           String               @id @default(cuid())
  title        String
  amount       Decimal              @db.Decimal(12, 2)
  type         String // income or expense
  date         DateTime
  notes        String?
  categoryId   String?
  category     FinancialCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accountId    String?
  account      FinancialAccount?    @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  commitmentId String?
  commitment   FinancialCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  importId     String?
  import       FinancialImport?     @relation(fields: [importId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId, accountId, date])
  @@index([userId, commitmentId])
  @@index([userId, importId])
}

model FinancialCommitment {
  id           String                 @id @default(cuid())
  title        String
  amount       Decimal                @db.Decimal(12, 2)
  type         String                 @default("expense")
  dueDate      DateTime
  recurrence   String                 @default("none")
  status       String                 @default("active")
  notes        String?
  categoryId   String?
  category     FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accountId    String?
  account      FinancialAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  transactions FinancialTransaction[]
  userId       Int
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([userId, status, dueDate])
}

model FinancialImport {
  id           String                 @id @default(cuid())
  name         String
  sourceType   String                 @default("statement")
  rowCount     Int                    @default(0)
  accountId    String
  account      FinancialAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions FinancialTransaction[]
  userId       Int
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([userId, createdAt])
}

model SavingsGoal {
  id            String                @id @default(cuid())
  title         String
  targetAmount  Decimal               @db.Decimal(12, 2)
  targetDate    DateTime?
  status        String                @default("active")
  userId        Int
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contributions SavingsContribution[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model SavingsContribution {
  id        String      @id @default(cuid())
  amount    Decimal     @db.Decimal(12, 2)
  date      DateTime    @default(now())
  notes     String?
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
}
