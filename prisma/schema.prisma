datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  name String?
  projects Project[]
  financialCategories FinancialCategory[]
  financialTransactions FinancialTransaction[]
  budgets Budget[]
  recurringBills RecurringBill[]
  plannedExpenses PlannedExpense[]
  savingsGoals SavingsGoal[]
  savingsContributions SavingsContribution[]
  financialSummaries FinancialSummary[]
  pomodoroSessions PomodoroSession[]
  inboxItems InboxItem[]
  notes Note[]
  notifications Notification[]
  createdAt DateTime @default(now())
}
model Project {
  id        String   @id @default(cuid())
  title     String
  color     String?
  lastActivityDate  DateTime?
  streakGlobal   Int? @default(0)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  habits    Habit[]
  tasks     Task[]
  inboxItems InboxItem[]
  notes Note[]
  createdAt DateTime @default(now())
}

model Habit {
  id          String   @id @default(cuid())
  title       String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  streak      Int      @default(0)
  history     String[] // Example: ["2025-12-25", "2025-12-26"]
  frequency   String   // e.g., "daily"
  reminderTime String?
  tasks       Task[]   
  inboxItems InboxItem[]
  notes Note[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  completed   Boolean  @default(false)
  date        DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  habitId     String?  // Links the task to the habit that generated it
  habit       Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dateFinish DateTime? 
  time        String?
  pomodoroSessions PomodoroSession[]
  inboxItems InboxItem[]
  notes Note[]
}

model InboxItem {
  id          String   @id @default(cuid())
  title       String
  content     String?
  type        String   @default("idea")
  status      String   @default("unprocessed")
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  habitId     String?
  habit       Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  habitId     String?
  habit       Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  inboxItems  InboxItem[]
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PomodoroSession {
  id              String   @id @default(cuid())
  durationMinutes Int
  focusType       String   @default("work") // work or study
  startedAt       DateTime
  endedAt         DateTime
  notes           String?
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FinancialCategory {
  id          String   @id @default(cuid())
  name        String
  type        String   // income or expense
  color       String?
  icon        String?
  isDefault   Boolean  @default(false)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions FinancialTransaction[]
  budgets     Budget[]
  recurringBills RecurringBill[]
  plannedExpenses PlannedExpense[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name, type])
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   // income or expense
  date        DateTime
  notes       String?
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Budget {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  month       String   // YYYY-MM
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId, month])
}

model RecurringBill {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  dueDay      Int
  frequency   String   @default("monthly")
  isActive    Boolean  @default(true)
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlannedExpense {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @default("expense") // income or expense
  plannedDate DateTime
  isPaid      Boolean  @default(false)
  notes       String?
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavingsGoal {
  id            String   @id @default(cuid())
  title         String
  targetAmount  Decimal  @db.Decimal(12, 2)
  currentAmount Decimal  @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  isCompleted   Boolean  @default(false)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contributions SavingsContribution[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavingsContribution {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  notes     String?
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialSummary {
  id            String   @id @default(cuid())
  month         String   // YYYY-MM
  totalIncome   Decimal  @default(0) @db.Decimal(12, 2)
  totalExpenses Decimal  @default(0) @db.Decimal(12, 2)
  netCashFlow   Decimal  @default(0) @db.Decimal(12, 2)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, month])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
}
