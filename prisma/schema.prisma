datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  name String?
  goals Goal[]
  financialCategories FinancialCategory[]
  financialTransactions FinancialTransaction[]
  budgets Budget[]
  recurringBills RecurringBill[]
  plannedExpenses PlannedExpense[]
  savingsGoals SavingsGoal[]
  savingsContributions SavingsContribution[]
  financialSummaries FinancialSummary[]
  accountSpendImports AccountSpendImport[]
  accountSpendEntries AccountSpendEntry[]
  pomodoroSessions PomodoroSession[]
  inboxItems InboxItem[]
  notes Note[]
  lifeHabits LifeHabit[]
  notifications Notification[]
  studySubjects StudySubject[]
  studyScheduleBlocks StudyScheduleBlock[]
  studyPlanBoards StudyPlanBoard[]
  studyMistakes StudyMistake[]
  studySessions StudySession[]
  studyQuestionPractices StudyQuestionPractice[]
  studyPlanProgress StudyPlanProgress[]
  createdAt DateTime @default(now())
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  description String?
  status    GoalStatus @default(ACTIVE)
  progress  Int        @default(0)
  targetDate DateTime?
  color     String?
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, targetDate])
}

model LifeHabit {
  id              String   @id @default(cuid())
  title           String
  kind            String   // good or bad
  color           String?
  notes           String?
  targetDays      Int      @default(30)
  reward          String?
  checkins        String[] @default([])
  badEvents       String[] @default([])
  lastBadAt       DateTime?
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, kind])
  @@index([userId, updatedAt])
}

model StudySubject {
  id                  String   @id @default(cuid())
  name                String
  color               String?
  plannedHoursPerWeek Int      @default(1)
  notes               String?
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scheduleBlocks      StudyScheduleBlock[]
  planBlocks          StudyPlanBlock[]
  mistakes            StudyMistake[]
  sessions            StudySession[]
  pomodoroSessions    PomodoroSession[]
  questionPractices   StudyQuestionPractice[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, name])
}

model StudySession {
  id              String   @id @default(cuid())
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  notes           String?
  subjectId       String
  subject         StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([userId, subjectId])
}

model StudyMistake {
  id            String   @id @default(cuid())
  question      String
  myAnswer      String
  correctAnswer String
  errorType     String
  correctRule   String
  examBoard     String?
  result        String?
  initialTopic  String?
  comment       String?
  correctionStatus String?
  generalSubject String?
  topic         String?
  microTopic    String?
  errorReason   String?
  chargedDetail String?
  trap          String?
  memorizationPhrase String?
  correctiveAction String?
  errorLevel    String?
  trapWord      String?
  reviewDate    DateTime?
  status        String   @default("unresolved") // unresolved, reviewed, mastered
  subjectId     String
  subject       StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status, reviewDate])
  @@index([userId, subjectId])
}

model StudyQuestionPractice {
  id               String   @id @default(cuid())
  practiceDate     DateTime
  totalQuestions   Int
  correctQuestions Int
  wrongQuestions   Int
  notes            String?
  subjectId        String
  subject          StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, practiceDate])
  @@index([userId, subjectId])
}

model StudyScheduleBlock {
  id        String       @id @default(cuid())
  dayIndex  Int
  hour      Int
  subjectId String
  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, subjectId, dayIndex, hour])
  @@index([userId, dayIndex, hour])
}

model StudyPlanBoard {
  id           String   @id @default(cuid())
  weekStartKey String
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blocks       StudyPlanBlock[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStartKey])
}

model StudyPlanBlock {
  id              String   @id @default(cuid())
  dayIndex        Int
  startTime       String
  durationMinutes Int
  notes           String?
  boardId         String
  board           StudyPlanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subjectId       String
  subject         StudySubject   @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([boardId, dayIndex, startTime])
  @@index([subjectId])
}

model StudyPlanProgress {
  id        String   @id @default(cuid())
  planKey   String
  itemId    String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, planKey, itemId])
  @@index([userId, planKey])
}

model InboxItem {
  id          String   @id @default(cuid())
  title       String
  content     String?
  type        String   @default("idea")
  status      String   @default("unprocessed")
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  inboxItems  InboxItem[]
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PomodoroSession {
  id              String   @id @default(cuid())
  title           String?
  durationMinutes Int
  focusType       String   @default("study") // study focus sessions
  startedAt       DateTime
  endedAt         DateTime
  notes           String?
  subjectId       String?
  subject         StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, endedAt])
  @@index([userId, subjectId])
}

model FinancialCategory {
  id          String   @id @default(cuid())
  name        String
  type        String   // income or expense
  color       String?
  icon        String?
  isDefault   Boolean  @default(false)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions FinancialTransaction[]
  budgets     Budget[]
  recurringBills RecurringBill[]
  plannedExpenses PlannedExpense[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name, type])
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   // income or expense
  date        DateTime
  notes       String?
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Budget {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  month       String   // YYYY-MM
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId, month])
}

model RecurringBill {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  dueDay      Int
  frequency   String   @default("monthly")
  isActive    Boolean  @default(true)
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlannedExpense {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @default("expense") // income or expense
  plannedDate DateTime
  isPaid      Boolean  @default(false)
  notes       String?
  categoryId  String
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavingsGoal {
  id            String   @id @default(cuid())
  title         String
  targetAmount  Decimal  @db.Decimal(12, 2)
  currentAmount Decimal  @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  isCompleted   Boolean  @default(false)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contributions SavingsContribution[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavingsContribution {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  notes     String?
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialSummary {
  id            String   @id @default(cuid())
  month         String   // YYYY-MM
  totalIncome   Decimal  @default(0) @db.Decimal(12, 2)
  totalExpenses Decimal  @default(0) @db.Decimal(12, 2)
  netCashFlow   Decimal  @default(0) @db.Decimal(12, 2)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, month])
}

model AccountSpendImport {
  id        String   @id @default(cuid())
  name      String
  month     String   // YYYY-MM
  sourceType String  @default("extrato") // extrato or fatura
  rowCount  Int      @default(0)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entries   AccountSpendEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sourceType, month])
  @@index([userId, createdAt])
}

model AccountSpendEntry {
  id          String   @id @default(cuid())
  date        DateTime
  month       String   // YYYY-MM, denormalized for fast month pagination
  sourceType  String   @default("extrato") // extrato or fatura
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @default("expense")
  description String
  importId    String
  import      AccountSpendImport @relation(fields: [importId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId, sourceType, month, date])
  @@index([importId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
}
